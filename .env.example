# انسخ الملف ده باسم .env (من غير example) وعدّل القيم
COMPANY_NAME=رحلات النيل
# اسم الموظف اللي بيرد على العملاء في الشات
AGENT_NAME=سارة

# ===== اختار واحد من الاتنين (حط مفتاح واحد بس) =====
# 1) Gemini — فيه مستوى مجاني. المفتاح من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 2) Anthropic Claude — مدفوع حسب الاستخدام. المفتاح من https://console.anthropic.com
ANTHROPIC_API_KEY=

# اختياري: اسم الموديل. سيبه فاضي: البرنامج بيختار موديل شغال لوحده
AI_MODEL=
